{
  "name": "site-natal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:local": "node --env-file-if-exists=.env scripts/local-postgres.mjs",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration.mjs",
    "format": "prettier --write src scripts tests next.config.ts tsconfig.json package.json README.md compose.yaml"
  },
  "dependencies": {
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
